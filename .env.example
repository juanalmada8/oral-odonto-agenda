# Local development. Copy to .env (never commit it). Docker Compose sets its own values.
APP_NAME=ORAL
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
APP_TIMEZONE=America/Argentina/Buenos_Aires
SECRET_KEY=change-me-with-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOG_FORMAT=text

# PostgreSQL started with `docker compose up -d db` (use @db:5432 from inside Compose).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/odonto_agenda
# Without Docker, SQLite works for development (production requires PostgreSQL):
# DATABASE_URL=sqlite+pysqlite:///./oral_local.db

# Public URL of the site (links in emails, Mercado Pago return/webhook URLs).
PUBLIC_BASE_URL=http://localhost:8000
CLINIC_NAME=ORAL odontología familiar
CLINIC_ADDRESS=
CLINIC_PHONE=

# Booking rules
BOOKING_MIN_LEAD_MINUTES=120
BOOKING_MAX_DAYS_AHEAD=60
BOOKING_MAX_ACTIVE_PER_PATIENT=2
BOOKING_HOLD_MINUTES=20
CANCELLATION_NOTICE_HOURS=24

# Deposit. Without MERCADOPAGO_ACCESS_TOKEN a local checkout simulator is used (never in production).
DEPOSIT_DEFAULT_AMOUNT=10000
CURRENCY=ARS
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Email (MailHog locally: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=turnos@oral.local

# WhatsApp Cloud API (see docs/WHATSAPP.md)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_REMINDER_TEMPLATE=recordatorio_turno
WHATSAPP_TEMPLATE_LANGUAGE=es_AR

REMINDER_HOURS_AHEAD=24
