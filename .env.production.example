# Production reference. On GCP these come from Terraform (env vars) and Secret Manager (marked [secret]);
# see docs/DEPLOYMENT.md. Never commit real values.
APP_NAME=ORAL
APP_ENV=production
DEBUG=false
APP_TIMEZONE=America/Argentina/Buenos_Aires
LOG_FORMAT=json
TRUST_PROXY_HEADERS=true
SECRET_KEY=                         # [secret] >= 32 random characters
DATABASE_URL=                       # [secret] postgresql+psycopg://USER:PASS@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

PUBLIC_BASE_URL=https://turnos.tu-dominio.com.ar
CLINIC_NAME=ORAL odontología familiar
CLINIC_ADDRESS=Av. ..., Belgrano, CABA
CLINIC_PHONE=11 ....-....

DEPOSIT_DEFAULT_AMOUNT=10000
MERCADOPAGO_ACCESS_TOKEN=           # [secret] APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=         # [secret] from the Webhooks section of your Mercado Pago app

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=turnos@tu-dominio.com.ar
SMTP_PASSWORD=                      # [secret] app password
SMTP_USE_TLS=true
EMAIL_FROM=turnos@tu-dominio.com.ar

WHATSAPP_ACCESS_TOKEN=              # [secret] permanent System User token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                # [secret]
WHATSAPP_VERIFY_TOKEN=              # [secret] any random string, also typed in Meta's webhook setup
